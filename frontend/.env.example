# Copy this file to .env (which is gitignored) and fill in real values.
# These are only used as a build-time fallback so every browser auto-connects
# with no manual step — see docs/PRODUCTION_DEPLOYMENT_GUIDE.md §5.3. The
# portal also works with NO .env file at all: it will show a one-time
# Connection screen instead, where the same two values can be entered by hand
# and are saved per-browser in localStorage.

# The backend API's base URL — e.g. https://api.yourcompany.com in production.
VITE_API_BASE=http://localhost:5025

# Must exactly match the server's Api__AdminKey environment variable.
# NEVER commit the real value — this file only ever holds a placeholder.
VITE_API_KEY=dev-change-me
